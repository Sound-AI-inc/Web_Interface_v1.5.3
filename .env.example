# SoundAI environment documentation (UX-024). Never commit real secrets.
# Required for authenticated app access. Production builds fail closed to
# /sign-in when these are missing; development falls back to an explicit
# demo workspace.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_WEBSITE_URL=http://127.0.0.1:4174
# Legacy aliases (optional fallbacks)
VITE_SUPABASE_ANON_KEY_web_interface=
VITE_SUPABASE_ANON_KEY_WEB_SITE=
# Optional. Defaults to "/api/generate" (same-origin Pages/Workers route).
# When unreachable, the generation gateway falls back to local demo synthesis
# and the UI must label results as Preview (see UX-002).
VITE_AI_GENERATION_API_URL=
# Optional inference backends. Each is tried after /api/generate; when unset
# or failing, that asset type falls back to demo synthesis with a Preview label.
# Development-only defaults below; leave unset in production unless provisioned.
VITE_SOUNDCRAFT_API_URL=http://127.0.0.1:8000
VITE_MIDICRAFT_API_URL=http://127.0.0.1:8001
VITE_VSTCRAFT_API_URL=http://127.0.0.1:8002
# P4-B: MusCraft (future modular music/audio) has no provisioned endpoint.
# Leave unset until the provider exists; adapters report it honestly.
VITE_MUSCRAFT_API_URL=

# Server-side (Workers / Pages Functions) - do not expose these to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HF_API_KEY=
HUGGINGFACE_INFERENCE_BASE_URL=
SOUNDAI_INTERNAL_INFERENCE_URL=
RUNPOD_API_KEY=
RUNPOD_API_URL=
AI_INFERENCE_TIMEOUT_MS=60000
AI_INFERENCE_RETRIES=2
GENERATION_CACHE_TTL_SECONDS=3600
ENTERPRISE_RATE_LIMIT_PER_MINUTE=120
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
